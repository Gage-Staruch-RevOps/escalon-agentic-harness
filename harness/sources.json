  "licensePolicy": {
    "_doc": "Commercial-use gate applied by build.mjs import (bin/license-policy.mjs). Blocks non-commercial licenses, vendor-proprietary copies (e.g. Anthropic all-rights-reserved skills, which are used natively instead) and skills with no license. trustedSources: sources known to be licensed although their skill folders carry no license file.",
    "trustedSources": {
      "account-plugins": "plugins installed on the company Claude account"
    }
  },
  "router": {
    "_doc": "skill-router's chains file; build.mjs index reads it so the hook can name the chain to run.",
