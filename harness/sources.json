{
  "_favorites_doc": "Skill names (or name@owner/repo when several skills share a name) that rank higher in every match. Add what you like, remove what keeps showing up unwanted, then run build.mjs index.",
  "_doc": "Where the harness gets its skills. Edit, then run: node ~/.claude/harness/bin/build.mjs all. Tiers: anthropic, author, vendor (official repo of the tool's maker), community. Repos left out on purpose are listed in SOURCES-SKIPPED.md.",
  "cache": "~/.cache/claude-harness/src",
  "promote": {
    "_doc": "Library skills copied into ~/.claude/skills so they register natively with the Skill tool. Every native skill costs context in every session, so this is limited to the UI chain (C17) core. Others stay reachable through the router.",
    "sources": [],
    "skills": [
      "design-engineering"
    ]
  },
  "favorites": [
    "humanizer",
    "stop-slop",
    "anti-slop-writing",
    "apple-design",
    "design-engineering",
    "better-typography",
    "better-colors",
    "better-ui",
    "frontend-design",
    "systematic-debugging",
    "verification-before-completion",
    "writing-plans@obra/superpowers",
    "planning-with-files",
    "ce-plan",
    "ce-code-review"
  ],
  "overrides": {
    "writing-plans": "engineering",
    "executing-plans": "engineering",
    "verification-before-completion": "engineering",
    "webapp-testing": "testing-qa",
    "write-swift": "mobile-apple",
    "animate-expo": "mobile-apple"
  },
  "local": [
    {
      "id": "claude-ai",
      "glob": "~/.claude/skills/synced/*",
      "layer": "20-account",
      "group": "claude-ai",
      "tier": "account",
      "native": "anthropic-skills:{name}"
    },
    {
      "id": "account-plugins",
      "glob": "~/.claude/plugins/synced/*",
      "layer": "20-account",
      "group": "plugins/{plugin}",
      "tier": "account",
      "native": "{plugin}:{name}"
    },
    {
      "id": "claude-plugins-official",
      "glob": "~/.claude/plugins/marketplaces/claude-plugins-official",
      "layer": "20-account",
      "group": "marketplace/{plugin}",
      "tier": "anthropic"
    }
  ],
